{
  "name": "@is_adou/dead-code-detector",
  "version": "1.1.1",
  "description": "Dead code detector - detect unused exports, Vue/React components",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "bin": {
    "dead-code": "./bin/dead-code.js"
  },
  "files": [
    "bin/",
    "src/",
    "types/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/dead-code.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ bin/ __tests__/",
    "lint:fix": "eslint src/ bin/ __tests__/ --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\""
  },
  "keywords": [
    "dead-code",
    "unused-code",
    "vue",
    "react",
    "detector",
    "ast",
    "code-analysis",
    "code-quality"
  ],
  "author": "Dead Code Detector Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adou377/dead-code-detector.git"
  },
  "bugs": {
    "url": "https://github.com/Adou377/dead-code-detector/issues"
  },
  "homepage": "https://github.com/Adou377/dead-code-detector#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@babel/traverse": "^7.24.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0"
  }
}
